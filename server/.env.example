# Copy to .env and adjust. Never commit the real .env.
PORT=4000
NODE_ENV=development

# Secret used to sign JWTs. MUST be set to a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Where the SQLite database and nightly backups live.
DATA_DIR=./data

# Nightly backup cron (server local time). Default: every night at 03:00.
BACKUP_CRON=0 3 * * *
# How many nightly / monthly snapshots to keep.
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12

# Comma separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Set to "true" to allow new account signups.
ALLOW_SIGNUP=true
